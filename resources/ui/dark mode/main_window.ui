<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>957</width>
    <height>573</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>AW3NIDS</string>
  </property>
  <property name="autoFillBackground">
   <bool>false</bool>
  </property>
  <property name="styleSheet">
   <string notr="true">/* AW3NIDS - modern dark theme
   Palette: bg #0F172A | surface #1E293B | border #334155 | text #E2E8F0
            muted #94A3B8 | accent #0EA5E9 */

* {
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, &quot;Product Sans&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif;
}

QMainWindow, QWidget#centralwidget {
    background-color: #0F172A;
}

QWidget {
    color: #E2E8F0;
}

QLabel {
    background: transparent;
    color: #E2E8F0;
}

QToolTip {
    background-color: #1E293B;
    color: #E2E8F0;
    border: 1px solid #334155;
    padding: 4px 8px;
}

/* ---------- Containers ---------- */

/* plain QFrames (page containers) are invisible; cards are opted in below */
.QFrame {
    background: transparent;
    border: none;
}

QStackedWidget {
    background: transparent;
    border: none;
}

QScrollArea,
QScrollArea &gt; QWidget &gt; QWidget {
    background: transparent;
    border: none;
}

#framePackets, #frameHosts, #frameStatus, #frameThreats,
#frameTotalAlerts, #frameCRIITICAL, #frameHIGH, #frameMEDIUM,
#frameTotalLogs, #frameWarnings, #frameErrors,
#frameTotalPackets, #frameTotalThreats, #frameActiveHosts, #frameUptime,
#frameReportsTotalAlerts, #frameHighAlerts, #frameMediumAlerts, #frameLowAlerts,
#frameState, #frameGraph, #frameThreatActivity, #frameAttackBreakdown {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 10px;
}

#graphContainer {
    background: transparent;
}

QGroupBox {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 10px;
    margin-top: 10px;
    padding-top: 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
    color: #94A3B8;
}

/* ---------- Sidebar ---------- */

#sidebarFrame {
    background-color: #1E293B;
    border: none;

}

#iblLogo {
    font-size: 16pt;
    font-weight: bold;
    color: #38BDF8;
    background: transparent;
}

#btnDashboard, #btnLiveCapture, #btnAlerts, #btnDatabase, #btnReports,
#btnSimulator, #btnAnalytics, #btnLogs, #btnSettings {
    background-color: transparent;
    color: #CBD5E1;
    border: none;
    border-radius: 8px;
    padding: 9px 12px;
    text-align: left;
    font-size: 11pt;
}

#btnDashboard:hover, #btnLiveCapture:hover, #btnAlerts:hover, #btnDatabase:hover,
#btnReports:hover, #btnSimulator:hover, #btnAnalytics:hover, #btnLogs:hover,
#btnSettings:hover {
    background-color: #334155;
    color: #FFFFFF;
}

#btnDashboard:pressed, #btnLiveCapture:pressed, #btnAlerts:pressed, #btnDatabase:pressed,
#btnReports:pressed, #btnSimulator:pressed, #btnAnalytics:pressed, #btnLogs:pressed,
#btnSettings:pressed {
    background-color: #0EA5E9;
    color: #FFFFFF;
}

/* selected page: either make the button checkable, or set property active=true */
#btnDashboard:checked, #btnLiveCapture:checked, #btnAlerts:checked, #btnDatabase:checked,
#btnReports:checked, #btnSimulator:checked, #btnAnalytics:checked, #btnLogs:checked,
#btnSettings:checked,
#btnDashboard[active=&quot;true&quot;], #btnLiveCapture[active=&quot;true&quot;], #btnAlerts[active=&quot;true&quot;],
#btnDatabase[active=&quot;true&quot;], #btnReports[active=&quot;true&quot;], #btnSimulator[active=&quot;true&quot;],
#btnAnalytics[active=&quot;true&quot;], #btnLogs[active=&quot;true&quot;], #btnSettings[active=&quot;true&quot;] {
    background-color: rgba(14, 165, 233, 0.18);
    color: #38BDF8;
    font-weight: 600;
}

/* ---------- Buttons ---------- */

QPushButton {
    background-color: #334155;
    color: #F1F5F9;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #3E4D66;
    border-color: #0EA5E9;
}

QPushButton:pressed {
    background-color: #0EA5E9;
    border-color: #0EA5E9;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #1E293B;
    color: #64748B;
    border-color: #334155;
}

/* primary actions */
#btnStartCapture, #btnRunSimulation, #btnGenerateReport, #btnSaveSettings, #btnBlockIP {
    background-color: #0EA5E9;
    border: 1px solid #0EA5E9;
    color: #FFFFFF;
    font-weight: 600;
}

#btnStartCapture:hover, #btnRunSimulation:hover, #btnGenerateReport:hover,
#btnSaveSettings:hover, #btnBlockIP:hover {
    background-color: #38BDF8;
    border-color: #38BDF8;
}

#btnStartCapture:pressed, #btnRunSimulation:pressed, #btnGenerateReport:pressed,
#btnSaveSettings:pressed, #btnBlockIP:pressed {
    background-color: #0284C7;
    border-color: #0284C7;
}

#btnStartCapture:disabled, #btnRunSimulation:disabled, #btnGenerateReport:disabled,
#btnSaveSettings:disabled, #btnBlockIP:disabled {
    background-color: #1E293B;
    border-color: #334155;
    color: #64748B;
}

/* destructive actions */
#btnStopCapture, #btnClearDatabase, #btnDeleteAlert, #btnClearLogs, #pushButton {
    background-color: transparent;
    border: 1px solid #7F1D1D;
    color: #F87171;
}

#btnStopCapture:hover, #btnClearDatabase:hover, #btnDeleteAlert:hover,
#btnClearLogs:hover, #pushButton:hover {
    background-color: #EF4444;
    border-color: #EF4444;
    color: #FFFFFF;
}

#btnStopCapture:pressed, #btnClearDatabase:pressed, #btnDeleteAlert:pressed,
#btnClearLogs:pressed, #pushButton:pressed {
    background-color: #DC2626;
    border-color: #DC2626;
    color: #FFFFFF;
}

#btnStopCapture:disabled, #btnClearDatabase:disabled, #btnDeleteAlert:disabled,
#btnClearLogs:disabled, #pushButton:disabled {
    background-color: transparent;
    border-color: #334155;
    color: #64748B;
}

/* ---------- Inputs ---------- */

QLineEdit, QTextEdit, QSpinBox, QDateEdit, QComboBox {
    background-color: #0F172A;
    color: #E2E8F0;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #0EA5E9;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QTextEdit:hover, QSpinBox:hover, QDateEdit:hover, QComboBox:hover {
    border-color: #475569;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border: 1px solid #0EA5E9;
}

QLineEdit:disabled, QSpinBox:disabled, QDateEdit:disabled, QComboBox:disabled {
    color: #64748B;
    background-color: #1E293B;
}

QComboBox QAbstractItemView {
    background-color: #1E293B;
    color: #E2E8F0;
    border: 1px solid #334155;
    selection-background-color: #0EA5E9;
    selection-color: #FFFFFF;
    outline: none;
}

#txtSimulationLog {
    background-color: #0B1220;
    color: #A7F3D0;
    font-family: &quot;Cascadia Mono&quot;, &quot;Consolas&quot;, &quot;Courier New&quot;, monospace;
    font-size: 9pt;
}

QCheckBox {
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #475569;
    border-radius: 4px;
    background-color: #0F172A;
}

QCheckBox::indicator:hover {
    border-color: #0EA5E9;
}

QCheckBox::indicator:checked {
    background-color: #0EA5E9;
    border-color: #0EA5E9;
}

/* ---------- Tables ---------- */

QTableWidget {
    background-color: #1E293B;
    alternate-background-color: #1A2438;
    color: #E2E8F0;
    gridline-color: #2B3A52;
    border: 1px solid #334155;
    border-radius: 8px;
    selection-background-color: rgba(14, 165, 233, 0.30);
    selection-color: #FFFFFF;
    outline: none;
}

QTableWidget::item {
    padding: 4px 6px;
    border: none;
}

QHeaderView {
    background: transparent;
}

QHeaderView::section {
    background-color: #162033;
    color: #94A3B8;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #334155;
    border-right: 1px solid #2B3A52;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #162033;
    border: none;
}

/* ---------- Scrollbars ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #475569;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #64748B;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #475569;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #64748B;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ---------- Menu / toolbar / status bar ---------- */

QMenuBar {
    background-color: #0F172A;
    color: #CBD5E1;
    border-bottom: 1px solid #1E293B;
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #1E293B;
}

QMenu {
    background-color: #1E293B;
    color: #E2E8F0;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #0EA5E9;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background: #334155;
    margin: 4px 6px;
}

QToolBar {
    background-color: #0F172A;
    border: none;
    border-bottom: 1px solid #1E293B;
    spacing: 6px;
    padding: 4px;
}

QToolButton {
    background: transparent;
    color: #E2E8F0;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 10px;
}

QToolButton:hover {
    background-color: #1E293B;
    border-color: #334155;
}

QToolButton:pressed {
    background-color: #0EA5E9;
    color: #FFFFFF;
}

QStatusBar {
    background-color: #0F172A;
    color: #94A3B8;
    border-top: 1px solid #1E293B;
}

/* ---------- Typography ---------- */

/* page titles */
#AlertsPageTitle, #LogsPageTitle, #AnalyitcsPageTitle, #lblReportsTitle,
#lblSimulatorTitle, #lblDatabaseTitle {
    font-size: 16pt;
    font-weight: bold;
    color: #F8FAFC;
}

/* subtitles and small captions */
#label_2, #lblReportsSubtitle,
#lblStatusTitle, #lblInterfaceTitle {
    color: #94A3B8;
}

/* section headers */
#lblLivePacketsHeader, #lblRecentAlerts, #lblIPResponse, #lblNetworkTraffic,
#lblLivePacketTable, #label_15, #label_16, #label_17, #label_18 {
    font-size: 9pt;
    font-weight: 600;
    color: #E2E8F0;
}

/* stat card titles */
#lblPacketTitle, #lblHostTitle, #lblNetworkStatusTitle, #lblThreatTitle,
#lblTotalAlertsTitle, #lblTotalAlertsTitle_2, #lblMediumTitle, #lblHighTitle,
#lblCriticalTitle, #lblHighTitle_2, #lblCriticalTitle_2,
#label_4, #label_6, #label_12, #label_13,
#lblReportTotalAlertsTitle, #lblReportHighAlertsTitle,
#lblReportMediumAlertsTitle, #lblReportLowAlertsTitle {
    font-size: 8pt;
    color: #94A3B8;
}

/* stat card values */
#lblPacketCount, #lblHostCount, #lblNetworkStatus, #lblThreatCount,
#lblTotalAlerts, #lblMediumAlerts, #lblHighAlerts, #lblCriticalAlerts,
#lblTotalLogs, #lblWarningLogs, #lblErrorLogs,
#lblTotalPackets, #lblTotalThreats, #lblActiveHosts, #lblUptime,
#label_22, #lblReportHighAlerts_2, #lblReportMediumAlerts, #lblReportLowAlerts,
#lblPortScanCount, #lblSynFloodCount, #lblIcmpFloodCount, #lblArpSpoofCount {
    font-size: 10pt;
    font-weight: bold;
    color: #F8FAFC;
}

/* severity colours (matched by label text, not by the frame names) */
#lblMediumTitle, #lblMediumAlerts, #lblWarningLogs, #lblReportMediumAlerts {
    color: #FBBF24;
}

#lblHighTitle, #lblHighAlerts, #lblReportHighAlerts_2 {
    color: #FB923C;
}

#lblCriticalTitle, #lblCriticalAlerts, #lblErrorLogs, #lblThreatCount {
    color: #F87171;
}

#lblReportLowAlerts {
    color: #4ADE80;
}
</string>
